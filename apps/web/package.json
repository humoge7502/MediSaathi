{
  "name": "medisaathi-web",
  "version": "0.3.0",
  "private": true,
  "description": "Vaidya — closed-loop medication guardian (Next.js product tier of MediSaathi). Every dependency here is imported; the scaffold kit was pruned deliberately.",
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build && node scripts/postbuild.mjs",
    "start": "node scripts/start-standalone.mjs 2>&1 | tee server.log",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "selftest": "bun scripts/selftest.ts",
    "parity": "bun ../../eval/parity/parity.ts",
    "test": "bun test tests/ --timeout=20000",
    "e2e": "bun run build && bun run db:push && playwright test",
    "db:push": "node scripts/db-push.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-toast": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.62.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "z-ai-web-dev-sdk": "^0.0.18"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-types": "^1.4.4",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
