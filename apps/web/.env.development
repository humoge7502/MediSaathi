# Loaded by `next dev` only (Next.js reads .env.development in development
# mode; `next build` / the standalone server never see this file, so a deployed
# container still runs on the deny-by-default side of the seed gate).
#
# The demo's "Reset demo data" button posts /api/seed {force:true}, which
# archives the active plans and rewrites the 14-day adherence timeline. With no
# authentication on the web tier, that route is only unlocked by an explicit
# operator opt-in — here, on a localhost dev server with a throwaway database.
MEDISAATHI_ALLOW_DEMO_RESET=1
