// Vaidya — Agentic Medication Guardian
// Schema: longitudinal medication lifecycle (verify → schedule → adhere → protect → measure)
// SQLite for the event build; single-file swap to Postgres post-event.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Patient {
  id        String            @id @default(cuid())
  name      String
  ageYears  Int?
  sex       String?
  // comma-separated context codes (pregnancy, renal_severe, peptic_ulcer, ...)
  contexts  String            @default("")
  createdAt DateTime          @default(now())
  plans     TherapyPlan[]
  alerts    EscalationEvent[]
  links     CaregiverLink[]
  prescriptions Prescription[]
  reminders ReminderSetting?
}

// A verified prescription record — provenance is never discarded.
model Prescription {
  id             String   @id @default(cuid())
  rawText        String
  verdict        String // pass | interaction | contraindication | duplicate | confirm_queue | refused
  confidence     Float
  extractionJson String // per-field extraction with confidences
  findingsJson   String // safety findings
  engineSnapshot String   // dataset snapshot tag for provenance
  // declared patient contexts (pregnancy, renal_severe, ...) that the run
  // was screened against — preserved so plan-start re-screening cannot
  // silently drop contraindications (same regression law as the API tier).
  contextsJson   String   @default("[]")
  // Gate-law provenance (MED-003): the frozen threshold-set id and the
  // prescription-level fused score (0.4·formulary ratio + 0.6·mean reading
  // confidence). A verdict without its parameters cannot be re-derived.
  thresholdSetId      String  @default("v1-2026-09")
  prescriptionFused   Float   @default(0)
  // Longitudinal regimen screen (TD-12): the regimen+propagation result the
  // published verdict was escalated from — nominal/worst verdict, fragility,
  // crossing findings. "{}" when no active regimen existed at verify time.
  regimenJson    String   @default("{}")
  createdAt      DateTime @default(now())
  plans          TherapyPlan[]
  queueItems     ConfirmQueueItem[]
  // Ownership (TD-1 progress): the patient whose visit produced this row —
  // stamped at verify time when a patient already exists, and claimed by the
  // plan that adopts the prescription otherwise. Nullable for exactly that
  // first-run order (verify on a fresh install precedes the first Patient row),
  // so NULL means "not claimed yet" and the plan write resolves it. A NON-NULL
  // value naming someone else is a foreign row, and every route that takes a
  // prescription id refuses it before it reads or writes anything.
  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id])

  @@index([patientId])
}

// Persisted confirmation queue — the human-resolution half of the gate law.
// A non-empty `pending` set for a prescription deterministically blocks plan
// generation (enforced inside the plan transaction, not in the UI).
model ConfirmQueueItem {
  id                String   @id @default(cuid())
  prescriptionId    String
  prescription      Prescription @relation(fields: [prescriptionId], references: [id])
  fieldIndex        Int
  rawText           String   @default("")
  readingConfidence Float    @default(0)
  fused             Float    @default(0)
  band              String   @default("confirm") // refused | confirm | auto
  why               String   @default("")
  state             String   @default("pending") // pending | confirmed | rejected
  resolvedBrand     String?
  actor             String   @default("system")
  note              String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([prescriptionId, fieldIndex])
  @@index([prescriptionId, state])
}

// Append-only audit of every queue transition (first transition wins).
model QueueTransition {
  id             String   @id @default(cuid())
  prescriptionId String
  fieldIndex     Int
  fromState      String
  toState        String
  actor          String   @default("system")
  note           String   @default("")
  createdAt      DateTime @default(now())

  @@index([prescriptionId, fieldIndex])
}

model TherapyPlan {
  id             String        @id @default(cuid())
  patientId      String
  patient        Patient       @relation(fields: [patientId], references: [id])
  prescriptionId String?
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id])
  status         String        @default("active") // active | completed | archived
  label          String        @default("")
  createdAt      DateTime      @default(now())
  medications    Medication[]
}

model Medication {
  id           String  @id @default(cuid())
  planId       String
  plan         TherapyPlan @relation(fields: [planId], references: [id])
  brand        String
  molecule     String
  atcClass     String  @default("")
  doseMg       Float
  frequencyCode String // OD | BD | TDS | QID | HS | QWK | SOS
  // JSON array of HH:MM times, e.g. ["08:00","20:00"]
  timesJson    String
  durationDays Int
  instructions String  @default("")
  doses        Dose[]
}

model Dose {
  id           String    @id @default(cuid())
  medicationId String
  medication   Medication @relation(fields: [medicationId], references: [id])
  scheduledAt  DateTime
  status       String    @default("pending") // pending | taken | skipped | missed
  actedAt      DateTime?
  note         String?
  @@index([scheduledAt])
}

model EscalationEvent {
  id          String   @id @default(cuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id])
  kind        String // interaction_alert | missed_streak | low_adherence | manual | dose_checkin
  severity    String   @default("info") // info | moderate | severe
  message     String
  acknowledged Boolean @default(false)
  createdAt   DateTime @default(now())
}

model CaregiverLink {
  id            String   @id @default(cuid())
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id])
  caregiverName String
  relation      String   @default("")
  code          String @unique
  createdAt     DateTime @default(now())
}

// Reminder preferences — the settings half of the notification law in
// src/lib/safety/reminders.ts. One row per patient, keyed by the unique
// patientId, so there is no id for a client to present and therefore no
// cross-patient write path: POST /api/reminders always targets the patient this
// build serves. Columns rather than a JSON blob because every one of them is a
// number with a stated bound (lead 0-180, late 0-720, clock minutes 0-1439) and
// `sanitizeSettings` is the only writer — a boundary that cannot be expressed as
// a type is a boundary that will eventually be bypassed by one.
model ReminderSetting {
  id            String   @id @default(cuid())
  patientId     String   @unique
  patient       Patient  @relation(fields: [patientId], references: [id])
  enabled       Boolean  @default(true)
  leadMinutes   Int      @default(10)
  lateMinutes   Int      @default(30)
  // A quiet window is a PAIR: both null means "no quiet hours", and the route
  // writes them together so a half-set window (start without an end) cannot
  // exist in the table. Values are local clock minutes from midnight.
  quietStartMinutes Int?
  quietEndMinutes   Int?
  mutedJson     String   @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  metaJson  String   @default("{}")
  createdAt DateTime @default(now())
}

model Metric {
  id    String @id @default(cuid())
  key   String @unique
  value Int    @default(0)
}
