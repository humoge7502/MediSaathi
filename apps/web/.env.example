# Copy to .env and adjust. The demo runs fully offline with no keys.
# SQLite database (Prisma). Relative paths resolve against prisma/schema.prisma:
DATABASE_URL="file:../db/custom.db"

# Optional: the Z AI model SDK reads a .z-ai-config file (project, home, or
# /etc) with { "baseUrl": ..., "apiKey": ... } for the LLM tier. Without it,
# /api/verify and /api/copilot degrade honestly (deterministic tier).
# Do not commit keys.

# Rate limiting on /api/* (Next.js proxy, per client, sliding window).
# These four go through `envPositiveNumber` (src/proxy.ts): set-but-empty or a
# non-numeric value falls back to the number below rather than becoming `0`, which
# would deny every write request. `0` is not a valid limit here; it is the typo.
MEDISAATHI_RATE_WRITE=60
MEDISAATHI_RATE_WRITE_WINDOW=60
MEDISAATHI_RATE_READ=300
MEDISAATHI_RATE_READ_WINDOW=60

# JSON body cap for every route handler, in KiB (src/lib/api-helpers.ts). The API
# tier spells the same idea in bytes (`MEDISAATHI_MAX_BODY_BYTES`); the web tier is
# in KiB because a prescription photograph's extracted text is kilobytes, not
# megabytes, and the upload path deliberately never persists the image.
MEDISAATHI_MAX_BODY_KB=64

# Evidence-suite cache window for POST /api/evals, in milliseconds. Inside the
# window a second caller is joined to or served the previous run instead of paying
# for ~20 model calls again. Unlike the limiter budgets above, an explicit `0` IS
# honoured here — it means "no window, run every time". Leaving the line *blank*
# is not a 0: a blank value reads as unset and keeps the default below.
MEDISAATHI_EVAL_REUSE_MS=120000

# X-Forwarded-For trust — set to 1 ONLY behind a proxy that overwrites XFF.
MEDISAATHI_TRUST_PROXY=0

# Privacy kill switch, the same one the API tier reads. At 1 the web tier raises
# before any request leaves the process (src/lib/ai/extraction.ts, copilot.ts), so
# the app answers from the deterministic engine and zero health data is transmitted
# to any model provider. This is the variable to set for a hospital or a demo with a
# patient in the room — and it has to reach BOTH containers, which docker-compose
# now does (it used to be passed only to `api`).
MEDISAATHI_DISABLE_MODEL_EGRESS=0

# Destructive demo reset (the "Reset demo data" button posts
# /api/seed {force:true}, which archives active plans and rewrites the
# adherence timeline). Denied unless one of these is set — `next dev` gets the
# opt-in from the committed .env.development, so a local demo works out of the
# box and a deployment never unlocks it by forgetting a variable.
MEDISAATHI_ALLOW_DEMO_RESET=
MEDISAATHI_ADMIN_TOKEN=

# Canonical public origin, used by /sitemap.xml, /robots.txt and the page metadata
# (opengraph/canonical URLs). SET IT AT BUILD TIME, NOT RUNTIME: `/` is prerendered
# and the metadata routes are generated by `next build`, so the value is frozen into
# the image. Verified on this repo — an image built without it serves
# `<loc>http://localhost:3000/</loc>` no matter what the container environment says,
# and `apps/web/Dockerfile` therefore takes it as a build ARG (`--build-arg` or the
# `build.args` entry in docker-compose.yml). Leave it unset for local work: the code
# falls back to http://localhost:3000, which is the coherent answer there.
NEXT_PUBLIC_SITE_URL=http://localhost:3000