# Copy to .env and adjust. The demo runs fully offline with no keys.
# SQLite database (Prisma). Relative paths resolve against prisma/schema.prisma:
DATABASE_URL="file:../db/custom.db"

# Optional: the Z AI model SDK reads a .z-ai-config file (project, home, or
# /etc) with { "baseUrl": ..., "apiKey": ... } for the LLM tier. Without it,
# /api/verify and /api/copilot degrade honestly (deterministic tier).
# Do not commit keys.

# Rate limiting on /api/* (Next.js middleware, per client, sliding window).
MEDISAATHI_RATE_WRITE=60
MEDISAATHI_RATE_WRITE_WINDOW=60
MEDISAATHI_RATE_READ=300
MEDISAATHI_RATE_READ_WINDOW=60

# X-Forwarded-For trust — set to 1 ONLY behind a proxy that overwrites XFF.
MEDISAATHI_TRUST_PROXY=0