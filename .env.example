# Copy to .env and fill only what you need. Demo runs fully offline (no keys).
# Never commit real keys.

# Live vision path (optional; fixtures carry the demo without it).
# Any OpenAI-compatible vision endpoint works:
#   Gemini:  base https://generativelanguage.googleapis.com/v1beta/openai  model gemini-2.0-flash
#   OpenAI:  base https://api.openai.com/v1                                model gpt-4o-mini
#   Ollama:  base http://localhost:11434/v1                                model llama3.2-vision
MEDISAATHI_VISION_KEY=
MEDISAATHI_VISION_MODEL=gemini-2.0-flash
MEDISAATHI_VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
MEDISAATHI_VISION_TIMEOUT_S=30

# Judge route (MS-08: default CLOSED). Set 1 ONLY on a demo laptop; public
# deployments keep it closed (403).
MEDISAATHI_JUDGE_OPEN=0

# Privacy kill switch (Ch.12): 1 = hard-disable every outbound model call on
# both tiers. The deterministic plane runs at full strength with zero
# third-party transmission. Leave 0 for the full/degraded tier demo.
MEDISAATHI_DISABLE_MODEL_EGRESS=0

# Destructive demo reset (MS-03): POST /api/seed {force:true} — the web app's
# "Reset demo data" — archives the active plans and rewrites the adherence
# timeline. There is no authentication on the web tier, so the route DENIES it
# unless one of these is set:
#   MEDISAATHI_ALLOW_DEMO_RESET=1   local/demo opt-in (a throwaway database)
#   MEDISAATHI_ADMIN_TOKEN=...      + the same value in an `x-admin-token`
#                                   header (an empty token never unlocks it)
# `next dev` loads apps/web/.env.development, which sets the opt-in for you.
# Deployments set neither, so the button answers 403 instead of wiping data.
MEDISAATHI_ALLOW_DEMO_RESET=
MEDISAATHI_ADMIN_TOKEN=

# CORS - deployed web origin + localhost for the demo
MEDISAATHI_CORS=http://localhost:3000

# Data dir override (defaults to repo ./data) and SQLite location
MEDISAATHI_DATA_DIR=
MEDISAATHI_DB_PATH=

# Build tag stamped into eval JSON results
MEDISAATHI_BUILD_TAG=dev

# Rate limiting (per client, sliding window). Defaults suit the demo; tighten
# for any public deployment.
MEDISAATHI_RATE_WRITE=60
MEDISAATHI_RATE_WRITE_WINDOW=60
MEDISAATHI_RATE_READ=300
MEDISAATHI_RATE_READ_WINDOW=60

# X-Forwarded-For trust. Set to 1 ONLY behind a proxy that OVERWRITES XFF
# (nginx, ALB, Cloudflare). Never enable on a directly exposed server: a
# client that can set its own XFF could rotate it to evade rate limits.
MEDISAATHI_TRUST_PROXY=0

# Request-body cap for JSON endpoints (multipart image uploads keep their own
# 12 MiB streaming cap). Enforced on every non-multipart request as a 413.
# The web tier spells its own cap in KiB: MEDISAATHI_MAX_BODY_KB (see
# apps/web/.env.example for the web-only knobs).
MEDISAATHI_MAX_BODY_BYTES=1048576

# Canonical public origin for the web tier, read by `docker-compose.yml` as a BUILD
# argument. It cannot be fixed at runtime: the landing page is prerendered and
# /robots.txt + /sitemap.xml are Next metadata routes, so the value is frozen into
# the image (verified — an image built without this serves
# <loc>http://localhost:3000/</loc> forever). Set it before `--build`, not after.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
