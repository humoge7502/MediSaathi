# MediSaathi monorepo - the four verbs your muscle memory needs.
# make setup | make test | make eval | make demo-check | make run

PY ?= python3
API_DIR := apps/api

.PHONY: setup test eval audit demo-check run web clean

setup:            ## install contracts + api (editable) and dev deps
	cd packages/contracts && $(PY) -m pip install -e . -q
	cd $(API_DIR) && $(PY) -m pip install -e ".[dev]" -q
	@echo "setup complete"

test:             ## safety-plane property tests + API golden paths
	cd $(API_DIR) && $(PY) -m pytest -q

eval:             ## fixture benchmark: brand recall, verdict agreement, refusal precision
	$(PY) eval/eval.py

audit:            ## static sanity: contracts importable, eval harness runs
	$(PY) -c "import medisaathi_contracts as m; print('contracts', m.__version__)"
	$(PY) eval/eval.py --json > /dev/null && echo "eval harness OK"

demo-check:       ## FULL offline demo gate - run before every rehearsal and after any merge
	@echo "== demo-check: offline pipeline through sealed cases =="
	$(PY) tools/demo_check.py
	$(MAKE) -s test
	$(MAKE) -s eval

run:              ## local API on :8000
	cd $(API_DIR) && $(PY) -m uvicorn app.main:app --reload --port 8000

web:              ## frontend dev (Block B5 onward)
	cd apps/web && npm install && npm run dev

clean:
	find . -name __pycache__ -type d -exec rm -rf {} + 2>/dev/null; true
